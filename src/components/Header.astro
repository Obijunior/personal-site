---
import "../styles/global.css"
import { ModeWatcher } from "mode-watcher";
import DarkMode from '../components/DarkMode.svelte';

const navLinks = [
  { name: 'Me', href: '#intro' },
  { name: 'Projects', href: '#projects' },
  { name: 'Experience', href: '#experience' }
];
---
<script is:inline>
  const isBrowser = typeof localStorage !== 'undefined';
  const getThemePreference = () => {
    if (isBrowser && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark' : 'light';
  };
  const isDark = getThemePreference() === 'dark';
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
 
  if (isBrowser) {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });
  }
</script>

<nav
    class="fixed hidden md:flex top-0 left-0 w-full bg-jewel-green/95 dark:bg-ink/95 backdrop-blur-md z-1000 border-b border-jewel-green-light/20 font-sans">
    <div class="w-full px-8 py-4 relative">
        <p class="font-bold font-serif text-parchment text-xl tracking-wide">Henry Nwagwu</p>
        <nav class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full">
            <ul class="flex justify-center gap-24 w-fit mx-auto black-dot-cursor">
                {navLinks.map((link) => (
                    <li class="list-none">
                        <a 
                            href={link.href} 
                            class="relative no-underline font-medium text-parchment/80 transition-all duration-300 hover:text-parchment hover:-translate-y-0.5 inline-block py-2 black-dot-cursor"
                        >
                            {link.name}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
        <!-- <div class="absolute right-8 top-1/2 -translate-y-1/2">
            <ModeWatcher client:load />
            <DarkMode client:load />
        </div> -->
    </div>
  </nav>
