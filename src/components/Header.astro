---
import "../styles/global.css"
import DarkMode from '../components/DarkMode.svelte';

const navLinks = [
  { name: 'Me', href: '#intro' },
  { name: 'Projects', href: '#projects' },
  { name: 'Experience', href: '#experience' }
];
---
<script is:inline>
  const isBrowser = typeof localStorage !== 'undefined';
  const getThemePreference = () => {
    if (isBrowser && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark' : 'light';
  };
  const isDark = getThemePreference() === 'dark';
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
 
  if (isBrowser) {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });
  }
</script>

<nav class="fixed flex flex-col md:flex-row top-0 left-0 w-full bg-jewel-green/95 dark:bg-ink/95 backdrop-blur-md z-1000 border-b border-jewel-green-light/20 font-sans">
    <div class="w-full px-6 py-3 md:px-8 md:py-4 flex items-center justify-between">
        <p class="font-bold font-serif text-parchment text-xl tracking-wide">Henry Nwagwu</p>
    </div>
    <div id="site-nav" class="w-full md:flex md:items-center md:justify-center">
        <ul class="flex flex-wrap justify-center gap-6 md:gap-24 px-4 pb-4 md:px-0 md:pb-0">
            {navLinks.map((link) => (
                <li class="list-none">
                    <a
                        href={link.href}
                        class="relative no-underline font-medium text-parchment/80 transition-all duration-300 hover:text-parchment hover:-translate-y-0.5 inline-block py-2"
                    >
                        {link.name}
                    </a>
                </li>
            ))}
        </ul>
    </div>
</nav>
