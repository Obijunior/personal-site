---
const navLinks = [
	{ name: "Me", href: "#about" },
	{ name: "Experience", href: "#experience" },
	{ name: "Education", href: "#education" },
];

const projectSections = [
	{ name: "Personal", href: "#projects-personal" },
	{ name: "Hackathon", href: "#projects-hackathon" },
	{ name: "Research", href: "#projects-research" },
];
---

<nav style="display:flex;align-items:center;justify-content:space-between;padding:20px 40px;border-bottom:1px solid #1e1e1e;position:sticky;top:0;background:rgba(12,12,12,0.92);backdrop-filter:blur(8px);z-index:50;">
  <div style="font-family:var(--mono);font-size:13px;font-weight:400;color:var(--fg2);letter-spacing:0.02em;">
    henrynwagwu<span style="color:var(--accent);">.me</span>
  </div>

  <ul style="display:flex;gap:32px;list-style:none;align-items:center;">
    {navLinks.map((link) => (
      <li>
        <a
          href={link.href}
          style="font-family:var(--mono);font-size:11px;font-weight:400;color:var(--fg3);text-decoration:none;letter-spacing:0.08em;text-transform:uppercase;transition:color 0.2s;"
          class="nav-link"
        >
          {link.name}
        </a>
      </li>
    ))}
    <li class="dropdown-wrapper">
      <a
        href="#projects"
        class="nav-link dropdown-trigger"
        style="font-family:var(--mono);font-size:11px;font-weight:400;color:var(--fg3);text-decoration:none;letter-spacing:0.08em;text-transform:uppercase;transition:color 0.2s;display:flex;align-items:center;gap:4px;"
      >
        Projects
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none" style="margin-top:1px;">
          <path d="M1.5 3L4 5.5L6.5 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <div class="nav-dropdown">
        {projectSections.map((section) => (
          <a href={section.href} class="dropdown-link">{section.name}</a>
        ))}
      </div>
    </li>
    <li class="dropdown-wrapper">
      <button
        class="nav-link contact-btn"
        style="font-family:var(--mono);font-size:11px;font-weight:400;color:var(--fg3);letter-spacing:0.08em;text-transform:uppercase;background:none;border:none;cursor:pointer;transition:color 0.2s;display:flex;align-items:center;gap:4px;"
      >
        Contact
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none" style="margin-top:1px;">
          <path d="M1.5 3L4 5.5L6.5 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="nav-dropdown">
        <a href="mailto:o.henry.nwagwu@gmail.com" class="dropdown-link">Email</a>
        <a href="https://linkedin.com/in/o-henry-nwagwu" target="_blank" rel="noopener noreferrer" class="dropdown-link">LinkedIn</a>
      </div>
    </li>
  </ul>
</nav>

<style>
  .nav-link:hover {
    color: var(--fg) !important;
  }

  .dropdown-wrapper {
    position: relative;
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    background: rgba(18, 18, 18, 0.96);
    border: 1px solid #222;
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    min-width: 140px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
  }

  .dropdown-wrapper:hover .nav-dropdown,
  .dropdown-wrapper:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 10px 16px;
    transition: color 0.2s, background 0.2s;
  }

  .dropdown-link:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.04);
  }
</style>
