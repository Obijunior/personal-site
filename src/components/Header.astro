---
const navLinks = [
	{ name: "Work", href: "#projects" },
	{ name: "About", href: "#experience" },
	{ name: "Contact", href: "mailto:o.henry.nwagwu@gmail.com" },
];
---

<nav style="display:flex;align-items:center;justify-content:space-between;padding:20px 40px;border-bottom:1px solid #1e1e1e;position:sticky;top:0;background:rgba(12,12,12,0.92);backdrop-filter:blur(8px);z-index:50;">
  <div style="font-family:var(--mono);font-size:13px;font-weight:400;color:var(--fg2);letter-spacing:0.02em;">
    henrynwagwu<span style="color:var(--accent);">.me</span>
  </div>

  <ul style="display:flex;gap:32px;list-style:none;">
    {navLinks.map((link) => (
      <li>
        <a
          href={link.href}
          style="font-family:var(--mono);font-size:11px;font-weight:400;color:var(--fg3);text-decoration:none;letter-spacing:0.08em;text-transform:uppercase;transition:color 0.2s;"
          class="nav-link"
        >
          {link.name}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-link:hover {
    color: var(--fg) !important;
  }
</style>
