---
import "../styles/global.css"
import { ModeWatcher } from "mode-watcher";
import DarkMode from '../components/DarkMode.svelte';
---
<script is:inline>
  const isBrowser = typeof localStorage !== 'undefined';
  const getThemePreference = () => {
    if (isBrowser && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark' : 'light';
  };
  const isDark = getThemePreference() === 'dark';
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
 
  if (isBrowser) {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });
  }
</script>

<nav
    class="fixed flex top-0 left-0 w-full bg-gray-200 dark:bg-emerald-900 backdrop-blur-md z-1000 border-b border-(--border-color) font-jetbrains">
    <div class="w-full px-8 py-4 relative">
        <p class="font-bold text-xl">Henry Nwagwu</p>
        <nav class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full">
            <ul class="flex justify-center gap-24 black-dot-cursor wd-fit">
                <li class="list-none">
                    <a class="relative no-underline font-medium hover:highlight">About</a>
                </li>
                <li class="list-none">
                    <a class="relative no-underline font-medium">Projects</a>
                </li>
                <li class="list-none">
                    <a class="relative no-underline font-medium">Contact</a>
                </li>
            </ul>
        </nav>
        <div class="absolute right-8 top-1/2 -translate-y-1/2">
            <ModeWatcher client:load />
            <DarkMode client:load />
        </div>
    </div>
  </nav>