<div id="custom-cursor-circle" class="custom-cursor"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const cursor = document.getElementById('custom-cursor-circle')
        if (!cursor) return

        let isOverTarget = false

        // Update cursor position
        document.addEventListener('mousemove', (e) => {
            cursor.style.setProperty('--x', `${e.clientX}px`)
            cursor.style.setProperty('--y', `${e.clientY}px`)
            
            // Check if mouse is over any .black-dot-cursor element
            const target = document.elementFromPoint(e.clientX, e.clientY)
            const isNowOver = target?.closest('.black-dot-cursor') !== null
            
            if (isNowOver !== isOverTarget) {
                isOverTarget = isNowOver
                if (isOverTarget) {
                    cursor.classList.add('expanded')
                } else {
                    cursor.classList.remove('expanded')
                }
            }
        })
    })
</script>
