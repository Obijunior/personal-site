---
const now = new Date();
const date = now.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: '2-digit' }).replace(/\//g, '.');
---

<section style="display:block;padding:80px 40px 60px;position:relative;border-bottom:1px solid #1a1a1a;">
  <div class="hero-label">// software engineering · cyber security · web3</div>

  <div class="hero-name">HENRY<br><span class="hero-name-dim">NWAGWU</span></div>

  <div class="hero-bio">
    Studying CS + Mathematics at the <em class="hero-bio-em">University of Kansas</em>. Building economic conflict simulations at the Trade War Lab, with interests in systems infrastructure, security research, quantitative modeling, and decentralized systems.
  </div>

  <div class="hero-tags">
    <span class="tag active">VICEROY Scholar</span>
    <span class="tag active">Trade War Lab</span>
  </div>

  <div class="hero-links">
    <a href="https://github.com/obijunior" target="_blank" rel="noopener noreferrer" class="hero-link">GitHub</a>
    <a href="https://linkedin.com/in/o-henry-nwagwu" target="_blank" rel="noopener noreferrer" class="hero-link">LinkedIn</a>
    <a href="/resume.pdf" class="hero-link">Resume</a>
    <a href="mailto:o.henry.nwagwu@gmail.com" class="hero-link">Email</a>
  </div>

  <div class="hero-counter">
    <div class="counter-num">{date}</div>
    <div class="counter-label">LAST UPDATED</div>
  </div>
</section>

<style>
  .hero-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .hero-name {
    font-family: var(--display);
    font-size: clamp(72px, 10vw, 120px);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--fg);
    margin-bottom: 24px;
    animation: fadeUp 0.6s ease both;
  }

  .hero-name-dim {
    color: var(--fg3);
  }

  .hero-bio {
    font-family: var(--body);
    font-size: 15px;
    font-weight: 300;
    color: var(--fg2);
    max-width: 420px;
    line-height: 1.7;
    margin-bottom: 36px;
    animation: fadeUp 0.6s 0.1s ease both;
  }

  .hero-bio-em {
    color: var(--accent);
    font-style: normal;
  }

  .hero-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 36px;
    animation: fadeUp 0.6s 0.2s ease both;
  }

  .tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border: 1px solid #222;
    color: var(--fg3);
    text-transform: uppercase;
  }

  .tag.active {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero-links {
    display: flex;
    gap: 20px;
    animation: fadeUp 0.6s 0.3s ease both;
  }

  .hero-link {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .hero-link::before {
    content: '↗';
    font-size: 10px;
  }

  .hero-link:hover {
    color: var(--accent);
  }

  .hero-counter {
    position: absolute;
    right: 40px;
    top: 80px;
    text-align: right;
  }

  .counter-num {
    font-family: var(--display);
    font-size: 120px;
    line-height: 1;
    color: #181818;
    user-select: none;
  }

  .counter-label {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: -8px;
  }

  @media (max-width: 768px) {
    .hero-counter {
      display: none;
    }
  }
</style>
