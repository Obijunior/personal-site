---
import { Github, Linkedin, Mail, Twitter } from '@lucide/astro';
---

<div id="intro" class="text-center font-sans mb-10 min-h-[70vh] flex flex-col justify-center items-center space-y-2">
    <h1 class="text-5xl font-bold font-serif text-jewel-green mb-4">Henry Nwagwu</h1>
    <p class="text-lg text-ink/90 font-medium tracking-wide mb-8">Computer Science + Economics @ KU</p>
    
    <div class="flex items-center justify-center space-x-6 mt-4">
        <a
            href="https://github.com/obijunior"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-ink/80 hover:text-black transition-colors duration-300"
        >
            <Github class="w-7 h-7" />
        </a>
        <a
            href="https://linkedin.com/in/o-henry-nwagwu"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-ink/80 hover:text-black transition-colors duration-300"
        >
            <Linkedin class="w-7 h-7" />
        </a>
        <a
            href="https://twitter.com/henry_nwagwu_"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter"
            class="text-ink/80 hover:text-black transition-colors duration-300"
        >
            <Twitter class="w-7 h-7" />
        </a>
        <a
            href="mailto:o.henry.nwagwu@gmail.com"
            aria-label="Email Me"
            class="text-ink/60 hover:text-black transition-colors duration-300"
        >
            <Mail class="w-7 h-7" />
        </a>
    </div>
</div>
