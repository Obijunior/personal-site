---
import { education, certifications, skills } from "../data";
---

<section id="education" style="padding:60px 40px;border-bottom:1px solid #1a1a1a;">
  <div class="section-header">
    <span class="section-title">Education & Skills</span>
    <div class="section-line"></div>
  </div>

  <div class="edu-grid">
    <div class="edu-col">
      {education.map((edu) => (
        <div class="edu-item">
          <div class="edu-institution">{edu.institution}</div>
          <div class="edu-degree">{edu.degree}</div>
          <div class="edu-meta">{edu.period} · {edu.location}</div>
          {edu.details && edu.details.length > 0 && (
            <div class="edu-coursework">
              <span class="edu-coursework-label">Relevant Courses:</span>
              <span class="edu-coursework-list">{edu.details.join(", ")}</span>
            </div>
          )}
        </div>
      ))}

      <div class="certs-block">
        <div class="subsection-label">Certifications</div>
        <div class="certs-list">
          {certifications.map((cert) => (
            <div class="cert-item">
              <span class="cert-name">{cert.name}</span>
              <span class="cert-issuer">{cert.issuer}</span>
              {cert.date && <span class="cert-date">{cert.date}</span>}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="edu-col">
      <div class="subsection-label">Skills</div>
      <div class="skills-list">
        {skills.map((group) => (
          <div class="skill-group">
            <div class="skill-category">{group.category}</div>
            <div class="skill-items">
              {group.items.map((item) => (
                <span class="skill-tag">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
  }
  .section-title {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .section-line {
    flex: 1;
    height: 1px;
    background: #1e1e1e;
  }

  .edu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }

  .edu-item {
    margin-bottom: 32px;
  }

  .edu-institution {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg);
    margin-bottom: 4px;
  }

  .edu-degree {
    font-family: var(--body);
    font-size: 14px;
    font-weight: 300;
    color: var(--fg2);
    margin-bottom: 4px;
  }

  .edu-meta {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.04em;
  }

  .edu-coursework {
    margin-top: 12px;
    line-height: 1.6;
  }

  .edu-coursework-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg3);
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 4px;
  }

  .edu-coursework-list {
    font-family: var(--body);
    font-size: 12px;
    font-weight: 300;
    color: var(--fg2);
  }

  .subsection-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .certs-block {
    margin-top: 8px;
  }

  .certs-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cert-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .cert-name {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
  }

  .cert-issuer {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
  }

  .cert-date {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg3);
    margin-left: auto;
  }

  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .skill-category {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .skill-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg2);
    border: 1px solid #222;
    padding: 3px 9px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .edu-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
