---
import { projects, experiences, education, certifications, skills } from "../../data";
import { getPublishedNotes } from "../../lib/notes";
import PixelGem from "../PixelGem.astro";

const notes = await getPublishedNotes();
const ed = education[0];
const stats = [
	{ k: "Based", v: "KS" },
	{ k: "Focus", v: "Systems" },
	{ k: "Grad", v: "2028" },
	{ k: "GPA", v: "3.72" },
];
const pad = (n: number) => String(n).padStart(2, "0");
---

<nav class="o-nav">
	<span class="brand">HENRYNWAGWU.ME</span>
	<div class="o-nav-links">
		<a href="#projects">projects</a>
		<a href="#experience">Experience</a>
		<a href="#education">Education</a>
		<div class="o-nav-drop">
			<button type="button" class="o-nav-trigger">
				Contact
				<svg width="8" height="8" viewBox="0 0 8 8" fill="none"><path d="M1.5 3L4 5.5L6.5 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</button>
			<div class="o-nav-menu">
				<a href="mailto:o.henry.nwagwu@gmail.com">Email</a>
				<a href="https://linkedin.com/in/o-henry-nwagwu" target="_blank" rel="noopener">LinkedIn</a>
			</div>
		</div>
	</div>
</nav>

<div class="wrap">
	<section class="o-hero">
		<div>
			<div class="o-kick">Software engineering · Cyber security · Web3</div>
			<h1 class="o-name">Henry<br /><span class="hl">Nwagwu</span></h1>
			<p class="o-bio">
				Studying CS + Mathematics at the University of Kansas. Building economic-conflict
				simulations at the Trade War Lab
				<!-- simulations at the <span class="accent-b">Trade War Lab</span> -->
			</p>
			<div class="o-actions">
				<a class="o-btn primary" href="https://github.com/Obijunior" target="_blank" rel="noopener">GitHub →</a>
				<a class="o-btn primary" href="https://linkedin.com/in/o-henry-nwagwu" target="_blank" rel="noopener">LinkedIn →</a>
				<a class="o-btn" href="/resume.pdf">Resume →</a>
				<a class="o-btn blue" href="mailto:o.henry.nwagwu@gmail.com">Contact →</a>
			</div>
		</div>
		<div class="o-gem"><PixelGem /></div>
	</section>

	<!-- <div class="o-stats">
		{stats.map((s) => (
			<div class="o-stat"><div class="v">{s.v}</div><div class="k">{s.k}</div></div>
		))}
	</div> -->

	<section class="o-sec" id="projects">
		<div class="o-sec-h"><span class="s">§ 01</span><span class="t">Selected Projects</span><span class="meta">{projects.length} entries</span></div>
		<div class="o-projs">
			{projects.map((p, i) => (
				<div class="o-proj">
					<div class="top">
						<span class="id">PROJ_{pad(i + 1)} · {p.category}</span>
						<span class="tag">{p.type}</span>
					</div>
					<h3>{p.title}</h3>
					<p>{p.description}</p>
					<div class="stk">{p.technologies.map((t) => <span>{t}</span>)}</div>
					{p.award && <div class="aw">★ {p.award}</div>}
					{(p.hostedLink || p.link) && (
						<div class="links">
							{p.hostedLink && <a href={p.hostedLink} target="_blank" rel="noopener">Live →</a>}
							{p.link && <a href={p.link} target="_blank" rel="noopener">Source →</a>}
						</div>
					)}
				</div>
			))}
		</div>
	</section>

	<section class="o-sec" id="experience">
		<div class="o-sec-h"><span class="s">§ 02</span><span class="t">Experience</span></div>
		{experiences.map((e) => (
			<details class="o-exp">
				<summary>
					<div class="pd">{e.period}</div>
					<div>
						<h3>{e.company}</h3>
						<div class="ti">{e.title}</div>
					</div>
					<div class="lo">{e.location}</div>
					<svg class="o-exp-caret" width="12" height="12" viewBox="0 0 8 8" fill="none"><path d="M1.5 3L4 5.5L6.5 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</summary>
				<ul class="ds">
					{e.description.map((d) => <li>{d}</li>)}
				</ul>
			</details>
		))}
	</section>

	<section class="o-sec" id="education">
		<div class="o-sec-h"><span class="s">§ 03</span><span class="t">Education &amp; Skills</span></div>
		<div class="o-edu">
			<div class="main">
				<div class="inst">{ed.institution}</div>
				<div class="deg">{ed.degree}</div>
				<div class="per">{ed.period} · {ed.location}</div>
				<div class="cw">{ed.details?.[0]}</div>
			</div>
			<div class="side">
				<div class="lab">// certifications</div>
				{certifications.map((c) => <div class="cert">{c.name}</div>)}
			</div>
		</div>
		<div class="o-skills">
			{skills.map((group) => (
				<div class="o-skill-group">
					<div class="lab">// {group.category}</div>
					<div class="o-skill-tags">
						{group.items.map((item) => <span class="o-skill-tag">{item}</span>)}
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- <section class="o-sec">
		<div class="o-sec-h"><span class="s">§ 04</span><span class="t">Writing</span><span class="meta">{notes.length} notes</span></div>
		{notes.map((n, i) => (
			<a class="o-post" href={`/notes/${n.slug}`}>
				<div class="n">{pad(i + 1)}</div>
				<div><h3>{n.title}</h3><p>{n.blurb}</p></div>
				<div class="dt">{n.dateLabel}<br />{n.tag}</div>
			</a>
		))}
	</section> -->

	<footer class="o-footer">
		<span>© 2026 Henry Nwagwu</span>
		<span>Built with <b>Astro</b> · Deployed on <b>Cloudflare</b></span>
	</footer>
</div>
