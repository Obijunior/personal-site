---
import styles from '../styles/global.css';
import Project from './Project.astro';

interface ProjectData {
  title: string;
  description: string;
  thumbnail: string;
  technologies: string[];
  link?: string;
}

const projects: ProjectData[] = [
  {
    title: 'TerraNova',
    description: 'TerraNova is an on-chain commodity trading platform that lets users explore markets and transact through the XRP Ledger.',
    thumbnail: '/images/TerraNovaPics/terraNovaHomepage.png',
    technologies: ['Next.js', 'TailwindCSS', 'XRPL'],
    link: 'https://github.com/Obijunior/kubi-cohort-2025',
  },
  {
    title: 'Echidna',
    description: 'The second project showcasing different technologies and a unique approach to problem-solving.',
    thumbnail: '',
    technologies: ['C', 'Mythic C2'],
    link: 'https://github.com/JamesNKing/echidna',
  },
  {
    title: 'ZillowNFT',
    description: 'A comprehensive solution demonstrating full-stack capabilities and modern development practices.',
    thumbnail: '/images/ZillowNFT.png',
    technologies: ['Next.js', 'TailwindCSS', 'Solidity'],
    link: 'https://github.com/FarrellJoswara/Block-a-Thon/tree/main',
  },
];
---

<div class="w-full px-4 font-jetbrains mb-16">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Projects</h1>
    <p class="text-lg text-gray-600">A showcase of my work</p>
  </div>
  
  <!-- Grid Layout: 2 columns -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 max-w-7xl mx-auto">
    {projects.map((project) => (
      <Project
        title={project.title}
        description={project.description}
        thumbnail={project.thumbnail}
        technologies={project.technologies}
        link={project.link}
      />
    ))}
  </div>
</div>