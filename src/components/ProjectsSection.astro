---
import { projects } from "../data";

const sections = [
  { type: "personal", title: "Personal" },
  { type: "hack-a-thon", title: "Hack-a-thon" },
  { type: "research", title: "Research" },
] as const;

let indexOffset = 0;
const groups = sections.map(({ type, title }) => {
  const items = projects.filter((p) => p.type === type);
  const remainder = items.length % 3;
  const startIndex = indexOffset;
  indexOffset += items.length;
  return {
    type,
    title,
    items,
    startIndex,
    remainder,
    lastRowSpan: remainder === 0 ? 2 : 6 / remainder,
    lastRowStart: items.length - (remainder || 3),
  };
});
---

<section id="projects" style="padding:60px 40px;border-bottom:1px solid #1a1a1a;">
    {groups.map((group) => (
    <Fragment>
      <div id={`projects-${group.type}`} class="section-header">
        <span class="section-title">{group.title} Projects</span>
        <div class="section-line"></div>
      </div>

      {group.items.length > 0 && (
        <div class="projects-grid">
          {group.items.map((project, i) => (
            <div class="project-card" style={i >= group.lastRowStart && group.remainder !== 0 ? `grid-column: span ${group.lastRowSpan}` : ''}>
              <div class="project-index">{String(group.startIndex+i+1).padStart(3, "0")} - {project.category}</div>
              <div class="project-name">{project.title}</div>
              <div class="project-desc">{project.description}</div>
              <div class="project-stack">
                {project.technologies.map((tech) => (
                  <span class="stack-tag">{tech}</span>
                ))}
              </div>
              {project.award && <div class="project-award">{project.award}</div>}
              {(project.hostedLink || project.link) && (
                <a href={project.hostedLink || project.link} target="_blank" rel="noopener noreferrer" class="project-link">
                  view →
                </a>
              )}
            </div>
          ))}
        </div>
      )}
    </Fragment>
  ))}
</section>


<style>
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
    scroll-margin-top: 80px;
  }
  .projects-grid + .section-header {
    margin-top: 64px;
  }
  .section-header--main {
    align-items: center;
    gap: 24px;
    margin-bottom: 56px;
  }
  .section-title--main {
    font-family: var(--display);
    font-size: 34px;
    color: var(--fg);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
  }
  .section-title {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .section-line {
    flex: 1;
    height: 1px;
    background: #1e1e1e;
  }
  .section-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: #1a1a1a;
  }

  .project-card {
    grid-column: span 2;
    background: var(--bg);
    padding: 28px;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
  }
  .project-card:hover {
    background: var(--bg2);
  }

  .project-visual {
    background: var(--bg3);
    border: 1px solid #1e1e1e;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
  }

  .vis-code {
    font-family: var(--mono);
    font-size: 8px;
    color: #5a8a5a;
    line-height: 1.5;
    padding: 12px;
    text-align: left;
    width: 100%;
    overflow: hidden;
  }
  .vis-code :global(.hl) {
    color: #6ec28e;
  }
  .vis-code :global(.dim2) {
    color: #3d6e3d;
  }

  .vis-text {
    font-family: var(--mono);
    font-size: 10px;
    color: #7a6a4a;
    line-height: 1.8;
    padding: 16px;
    text-align: left;
    width: 100%;
  }
  .vis-text :global(.hl) {
    color: var(--accent);
  }

  .vis-label {
    font-family: var(--display);
    font-size: 36px;
    color: #1e1e1e;
    letter-spacing: 0.04em;
  }

  .vis-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-index {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg3);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .project-name {
    font-family: var(--display);
    font-size: 22px;
    letter-spacing: 0.04em;
    color: var(--fg);
    margin-bottom: 8px;
    line-height: 1;
  }
  .project-desc {
    font-family: var(--body);
    font-size: 13px;
    font-weight: 300;
    color: var(--fg2);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .project-stack {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .stack-tag {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--fg3);
    border: 1px solid #222;
    padding: 2px 7px;
    letter-spacing: 0.04em;
  }

  .project-award {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .project-award::before {
    content: '★ ';
  }

  .project-link {
    position: absolute;
    bottom: 32px;
    right: 32px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg3);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }
  .project-card:hover .project-link {
    color: var(--accent);
  }

  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .project-card {
      grid-column: span 1 !important;
    }
  }
  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
