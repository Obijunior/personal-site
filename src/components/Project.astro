---
interface Props {
  title: string;
  description: string;
  thumbnail: string;
  technologies: string[];
  link?: string;
}

const { title, description, thumbnail, technologies, link = '#' } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300 h-full flex flex-col">
  <!-- Thumbnail -->
  <div class="w-full overflow-hidden bg-gray-200 flex-shrink-0 aspect-video">
    <img src={thumbnail} alt={title} class="w-full h-full object-cover" />
  </div>
  
  <!-- Content -->
  <div class="p-6 flex flex-col flex-grow">
    <h3 class="text-2xl font-semibold mb-3 text-gray-900">{title}</h3>
    <p class="text-gray-600 text-base mb-6 line-clamp-4 flex-grow">{description}</p>
    
    <!-- Technologies -->
    <div class="mb-6 flex flex-wrap gap-2">
      {technologies.map((tech) => (
        <span class="inline-block bg-blue-100 text-blue-800 text-sm px-3 py-1 rounded">
          {tech}
        </span>
      ))}
    </div>
    
    <!-- Link -->
    <a href={link} class="inline-block text-blue-500 hover:text-blue-700 font-medium text-base black-dot-cursor">
      View Project →
    </a>
  </div>
</div>