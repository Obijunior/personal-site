---
interface Props {
  title: string;
  description: string;
  thumbnail?: string;
  technologies: string[];
  hostedLink?: string;
  link?: string;
}

const { title, description, thumbnail, technologies, hostedLink, link = '#' } = Astro.props;
---

<div class="bg-parchment-dark/60 border border-jewel-green/10 rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
  <!-- Thumbnail -->
  {thumbnail ? (
    <div class="w-full overflow-hidden bg-gray-200 flex-shrink-0 aspect-video">
      <img src={thumbnail} alt={title} class="w-full h-full object-cover" />
    </div>
  ) : (
    <div class="px-6 pt-6">
      <div class="h-1 w-16 bg-jewel-green/80"></div>
    </div>
  )}
  
  <!-- Content -->
  <div class="p-6 flex flex-col flex-grow">
    {hostedLink ? (
      <a href={hostedLink} target='_blank' class="inline-block text-ink hover:text-jewel-green transition-colors duration-200 black-dot-cursor">
        <h3 class="text-2xl font-bold font-serif mb-3 tracking-wide">{title}</h3>
      </a>
    ) : (
      <h3 class="text-2xl font-bold font-serif mb-3 text-ink tracking-wide">{title}</h3>
    )}
    <p class="text-ink/80 text-base mb-6 line-clamp-5 flex-grow font-medium leading-relaxed">{description}</p>
    
    <!-- Technologies -->
    <div class="mb-6 flex flex-wrap gap-2">
      {technologies.map((tech) => (
        <span class="inline-block bg-jewel-sapphire/10 text-jewel-sapphire border border-jewel-sapphire/20 font-medium text-xs px-3 py-1 rounded-full">
          {tech}
        </span>
      ))}
    </div>
    
    <!-- Link -->
    <a href={link} class="inline-block text-jewel-green-light hover:text-jewel-green font-medium text-sm tracking-wide uppercase mt-auto black-dot-cursor transition-colors duration-200">
      View Project →
    </a>
  </div>
</div>
