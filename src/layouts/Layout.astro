---
import '../styles/global.css';
import BlackDotCursor from '../components/BlackDotCursor.astro';

const title = "Henry Nwagwu | Portfolio"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="cursor-white">


	<slot />
	<BlackDotCursor />
	</body>
</html>


